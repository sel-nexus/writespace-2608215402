# File-backed SQLite database used by the backend.
DATABASE_URL=sqlite:///./data/writespace.db
# Enable the restart-safe development admin seed.
SEED_ON_STARTUP=true
# Comma-separated browser origins permitted during local development.
CORS_ORIGINS=http://localhost:5173
# Signing key for access tokens; replace with a strong secret in every environment.
JWT_SECRET=
# Access-token lifetime in minutes.
JWT_EXPIRATION_MINUTES=60
